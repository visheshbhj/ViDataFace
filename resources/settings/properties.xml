<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <property id="UseMilitaryFormat" type="boolean">false</property>
    <!-- Index into SecondZone.ZONES. The watch's own alternate time zones are
         not readable from Connect IQ, so the zone is picked here. -->
    <property id="SecondZone" type="number">0</property>

    <!-- Barometric trend. Ranges are enforced again in Settings.mc. -->
    <property id="TrendRefreshMin" type="number">5</property>
    <property id="TrendWindowHours" type="number">4</property>

    <!-- The battery ring turns yellow at or below this percentage. -->
    <property id="BatteryLowPct" type="number">40</property>

</properties>
